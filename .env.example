# Copia para .env e preenche (NUNCA commits o .env)

# Chave SECRETA — só no servidor (Dashboard Stripe → API keys → Secret key)
STRIPE_SECRET_KEY=sk_live_...

# Chave publicável — obrigatória para checkout no site (Dashboard → API keys → Publishable key)
STRIPE_PUBLISHABLE_KEY=pk_test_...

PORT=3000
# URL pública do site (produção: https://zendywear.com)
CLIENT_URL=http://localhost:3000

# Promo lançamento — primeiras N unidades (total, todas as camisolas)
PROMO_UNIT_LIMIT=50
PROMO_COMPARE_EUR=45
PROMO_PRICE_EUR=29.99
REGULAR_PRICE_EUR=45

# Stripe webhook (Dashboard → Developers → Webhooks → checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...
